{
  "info": {
    "_postman_id": "a9010ef8-161d-44a0-8a4f-ambulanceconnect",
    "name": "AmbulanceConnect API Collection",
    "description": "Complete Postman API test collection for AmbulanceConnect Emergency Ambulance Service Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ambulanceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"patient@ambulance.com\",\n  \"password\": \"patient123\",\n  \"phone\": \"+1-555-0301\",\n  \"role\": \"patient\",\n  \"emergencyContact\": {\n    \"name\": \"Mary Doe\",\n    \"phone\": \"+1-555-0302\",\n    \"relationship\": \"Spouse\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (Patient / Admin / Driver)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@ambulance.com\",\n  \"password\": \"patient123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Ambulances",
      "item": [
        {
          "name": "Get Available Ambulances",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ambulances/available?type=ALS", "host": ["{{baseUrl}}"], "path": ["ambulances", "available"], "query": [{ "key": "type", "value": "ALS" }] }
          }
        },
        {
          "name": "List All Ambulances",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ambulances", "host": ["{{baseUrl}}"], "path": ["ambulances"] }
          }
        },
        {
          "name": "Register Ambulance (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ambulanceNumber\": \"AMB-201\",\n  \"registrationNumber\": \"KA-05-MM-9999\",\n  \"type\": \"ALS\",\n  \"location\": {\n    \"latitude\": 12.9750,\n    \"longitude\": 77.5990,\n    \"address\": \"North Hub Bay 2\"\n  },\n  \"equipment\": [\"Oxygen Tank\", \"Defibrillator\", \"ECG Monitor\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/ambulances", "host": ["{{baseUrl}}"], "path": ["ambulances"] }
          }
        },
        {
          "name": "Get Ambulance By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/ambulances/{{ambulanceId}}", "host": ["{{baseUrl}}"], "path": ["ambulances", "{{ambulanceId}}"] }
          }
        },
        {
          "name": "Update Ambulance Location (Driver/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 12.9745,\n  \"longitude\": 77.5975,\n  \"address\": \"En Route on MG Road\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ambulances/{{ambulanceId}}/location", "host": ["{{baseUrl}}"], "path": ["ambulances", "{{ambulanceId}}", "location"] }
          }
        },
        {
          "name": "Simulate Ambulance Movement (Demo Mode)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetLat\": 12.9720,\n  \"targetLng\": 77.6050,\n  \"stepFraction\": 0.2\n}"
            },
            "url": { "raw": "{{baseUrl}}/ambulances/{{ambulanceId}}/simulate-move", "host": ["{{baseUrl}}"], "path": ["ambulances", "{{ambulanceId}}", "simulate-move"] }
          }
        }
      ]
    },
    {
      "name": "3. Emergency Requests",
      "item": [
        {
          "name": "Create Emergency Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.request) {",
                  "    pm.collectionVariables.set('requestId', jsonData.data.request._id);",
                  "    if (jsonData.data.request.ambulanceId) {",
                  "        pm.collectionVariables.set('ambulanceId', jsonData.data.request.ambulanceId._id || jsonData.data.request.ambulanceId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"address\": \"MG Road Metro Station, Gate 2\",\n    \"latitude\": 12.9755,\n    \"longitude\": 77.6066\n  },\n  \"destination\": {\n    \"hospitalName\": \"City Emergency General Hospital\",\n    \"address\": \"Residency Road, Bangalore\",\n    \"latitude\": 12.9690,\n    \"longitude\": 77.6020\n  },\n  \"patientContactNumber\": \"+1-555-0301\",\n  \"emergencyType\": \"Accident & Trauma\",\n  \"requestedAmbulanceType\": \"ALS\",\n  \"description\": \"Pedestrian injured, conscious but unable to stand.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "Get My Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/my", "host": ["{{baseUrl}}"], "path": ["requests", "my"] }
          }
        },
        {
          "name": "Get Request Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
          }
        },
        {
          "name": "Get Request Status & Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "Get Assigned Ambulance Location",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/location", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "location"] }
          }
        },
        {
          "name": "Update Request Status (DISPATCHED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISPATCHED\",\n  \"note\": \"Ambulance dispatched with emergency beacon active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "Cancel Ambulance Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"Patient boarded neighbor car to hospital\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/cancel", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin Dashboard & Analytics",
      "item": [
        {
          "name": "Admin Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "Admin Emergency Requests List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/requests", "host": ["{{baseUrl}}"], "path": ["admin", "requests"] }
          }
        },
        {
          "name": "Admin Fleet Inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/ambulances", "host": ["{{baseUrl}}"], "path": ["admin", "ambulances"] }
          }
        },
        {
          "name": "Admin Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/analytics", "host": ["{{baseUrl}}"], "path": ["admin", "analytics"] }
          }
        }
      ]
    }
  ]
}
