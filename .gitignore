# ==========================================
# Dependencies
# ==========================================
node_modules/
*/node_modules/
.pnp
.pnp.js

# ==========================================
# Environment Variables & Secrets
# (Never push credentials/secrets to GitHub)
# ==========================================
.env
.env.*
!.env.example
!*/.env.example
**/.env
**/.env.*
!**/.env.example
*.local

# ==========================================
# Build & Distribution Outputs
# ==========================================
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ==========================================
# Logs & Runtime Data
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Testing & Code Coverage
# ==========================================
coverage/
.nyc_output/

# ==========================================
